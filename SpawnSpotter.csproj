<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SpawnSpotter</RootNamespace>
    <AssemblyName>SpawnSpotter</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />

    <!-- AOT settings: only kick in on publish (so test project can ProjectReference us). -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <StripSymbols>true</StripSymbols>

    <!--
      Spectre.Console.Cli 0.55 emits AOT/trim warnings (IL2104, IL3050, IL3053, IL3000) under
      Native AOT, even though the strongly-typed CommandSettings surface we use does not exercise
      the dynamic-reflection paths at runtime. We pin a known-good version, suppress the
      warnings, and verify command dispatch in the published AOT binary.
    -->
    <NoWarn>$(NoWarn);IL2104;IL3050;IL3053;IL3000</NoWarn>

    <!-- Assembly / Win32 file-properties metadata. Most fields are surfaced by
         Windows Explorer (Properties -> Details). Version-related fields are
         stamped by MinVer below from the nearest git tag. -->
    <AssemblyTitle>SpawnSpotter</AssemblyTitle>
    <Product>SpawnSpotter</Product>
    <Company>SixFive7</Company>
    <Authors>SixFive7</Authors>
    <Copyright>Copyright (c) SixFive7 contributors</Copyright>
    <Description>Logs the process chain behind every focus change you didn't ask for. Single-binary Native-AOT Windows 11 tool.</Description>
    <RepositoryUrl>https://github.com/SixFive7/SpawnSpotter</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/SixFive7/SpawnSpotter</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- MinVer reads the version from the nearest git tag (prefix 'v').
         - On a tag (e.g. v1.2.3)              -> 1.2.3
         - N commits past a tag                 -> 1.2.4-alpha.0.N
         - No tags / shallow clone              -> 0.0.0-alpha.0.<height>
         The SDK appends '+<git-sha>' to InformationalVersion automatically
         (IncludeSourceRevisionInInformationalVersion is on by default). -->
    <MinVerTagPrefix>v</MinVerTagPrefix>

    <!-- Embed the UAC / DPI / OS-compat manifest into the output exe. The manifest
         requests requireAdministrator - ETW kernel-process tracing needs it. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Embed the Crosshair-Eye icon as Win32 resource. conhost picks this up
         for the console window's title bar / taskbar / Alt+Tab automatically. -->
    <ApplicationIcon>SpawnSpotter.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Only set self-contained / RID for publish. Build alone produces a normal framework-dependent dll/exe. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true' or '$(IsPublishing)' == 'true' or '$(PublishAotPlease)' == 'true'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!--
    The main csproj sits at repo root and the SDK's default <Compile> glob is **/*.cs,
    which would pick up tests/. Exclude tests explicitly to keep the boundaries clean.
  -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <Content Remove="tests\**" />
    <None Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Spectre.Console.Cli" />
    <TrimmerRootAssembly Include="SpawnSpotter" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
    <!-- Build-time only; no runtime dependency, AOT-safe. -->
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <!-- Populates SourceRevisionId from git so the SDK can append '+<sha>' to
         InformationalVersion. Also stamps PDB source paths to GitHub URLs.
         Build-time only, no runtime dependency. -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

</Project>
